#!/bin/bash
#PBS -N strong_hybrid_128
#PBS -q short_cpuQ
#PBS -l select=4:ncpus=96:mpiprocs=32
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o results/strong_hybrid_128.log

set -euo pipefail
cd "$PBS_O_WORKDIR"

module purge
module load gcc91
module load mpich-3.2.1--gcc-9.1.0

mkdir -p results

: "${MATRIX:?Use qsub -v MATRIX=matrix/.../...mtx}"
: "${ITERS:=50}"
: "${WARMUP:=3}"
: "${RUNS:=10}"
: "${SEED:=1}"

TOTAL_CORES_FIXED=128

# Exact pairs (P,T) with P*T=128
P_LIST=(128 64 32 16 8 4 2)
T_LIST=(  1  2  4  8 16 32 64)

TAG="$(basename "$(dirname "$MATRIX")")"
OUTCSV="results/strong_${TAG}_hybrid_128.csv"

mpicxx -O3 -std=c++17 -fopenmp -march=native -o src/smpv_d2 src/smpv_d2.cpp
[ -x src/smpv_d2 ] || { echo "Build failed"; exit 11; }

export OMP_PROC_BIND=close
export OMP_PLACES=cores

rm -f "$OUTCSV"

for idx in "${!P_LIST[@]}"; do
  P="${P_LIST[$idx]}"
  T="${T_LIST[$idx]}"

  if [ $((P*T)) -ne "$TOTAL_CORES_FIXED" ]; then
    echo "[skip] invalid pair P=$P T=$T"
    continue
  fi

  export OMP_NUM_THREADS="$T"

  echo "[run] P=$P T=$T (P*T=$((P*T)))"
  mpirun -np "$P" ./src/smpv_d2 \
    --case strong \
    --matrix "$MATRIX" \
    --seed "$SEED" \
    --iters "$ITERS" \
    --warmup "$WARMUP" \
    --runs "$RUNS" \
    --out "$OUTCSV"
done

